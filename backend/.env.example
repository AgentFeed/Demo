# Runtime mode: sqlite (local demo) or supabase (real Auth/Postgres/pgvector)
APP_ENV=local
BCT_STORE_BACKEND=sqlite
BCT_DB_PATH=../data/bharat_twin.db

# Supabase project settings for production mode
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:3000

# Agent providers
USE_LANGGRAPH=true
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Optional hosted OpenAI-compatible embedding endpoint:
# EMBEDDING_API_URL=https://your-embedding-service/v1/embeddings
# EMBEDDING_API_KEY=replace-me

# Freehire source: public API, JSON export, or direct freehire Postgres
FREEHIRE_API_URL=https://freehire.me/api/v1/jobs
FREEHIRE_API_KEY=
FREEHIRE_MAX_PAGES=10
# FREEHIRE_JSON_URL=/absolute/path/to/freehire-export.json
# FREEHIRE_DATABASE_URL=postgresql://user:password@localhost:5432/freehire

# Official scheme ingestion through data.gov.in/MyScheme-compatible API
MYSCHEME_API_URL=https://api.data.gov.in/resource/RESOURCE_ID
MYSCHEME_API_KEY=replace-me
MYSCHEME_RESOURCE_ID=replace-me

# Learned ranker artifact (generated by app.cron.train_ranker)
# BCT_RANKER_MODEL_PATH=/absolute/path/to/models/ranker.json

# Protect ingestion/sync endpoints
BCT_ADMIN_TOKEN=replace-me
